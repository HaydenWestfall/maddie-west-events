# Maddie West Events — Hostinger (Apache/LiteSpeed) config.
#
# Lives in /public so Vite copies it into dist/ on every build. Two jobs:
#   1. Serve the pre-rendered per-route HTML the static-SEO plugin generates
#      (see vite.config.ts) for clean URLs, so crawlers get real <head> tags.
#   2. Fall back to index.html for everything else, so React Router handles
#      deep links instead of the server 404ing.

Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # /about -> /about/index.html, served in place (no 301 to a trailing slash,
  # which would fight the canonical URLs in seo.config.ts).
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # SPA fallback for any path that is not a real file or directory.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>

# HTML must never be cached: index.html points at hash-named asset bundles that
# change every build, so a stale copy references files that no longer exist.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Content-hashed bundles are safe to cache forever.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(woff2?|ttf|otf|eot|jpe?g|png|webp|gif|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml \
    image/svg+xml application/manifest+json
</IfModule>

# Don't serve stray dotfiles (.DS_Store, .env, ...) if one ever gets uploaded.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

ErrorDocument 404 /index.html
